<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Package Information -->
    <PackageId>Jyro.Cli</PackageId>
    <AssemblyName>Jyro</AssemblyName>
    <RootNamespace>RealTree.Jyro.Cli</RootNamespace>
    <Version>1.0.0-rc.1</Version>
    <Authors>RealTree Systems</Authors>
    <Company>RealTree Systems</Company>
    <Summary>Command line interpreter for the Jyro language.</Summary>
    <Product>Jyro</Product>
    <Description>Jyro is an imperative data manipulation language designed for secure, sandboxed processing of JSON-like data structures.</Description>
    <PackageProjectUrl>https://github.com/realtree-systems/jyro-cli</PackageProjectUrl>
    <RepositoryUrl>https://github.com/realtree-systems/jyro-cli</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © 2025-2026 RealTree Systems.</Copyright>
    <PackageTags>jyro;command;scripting;json;language;sandbox;commandline</PackageTags>
    <!-- IL2040/IL2104: trim warnings internal to FSharp.Core and FParsecCS NuGet packages
		     IL2026: Expression.Property in Jyro.Compiler uses reflection by design -->
    <NoWarn>IL2040;IL2104;IL2026</NoWarn>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Keep the Jyro libraries' XML API docs out of the published CLI -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <!-- The man pages are the reference manual of the jyro-doc repository
         (https://github.com/realtree-systems/jyro-doc), cloned beside this one.
         Its layout, manual/<NN Section>/[<NN Subsection>/]<NN Page>.md, is the
         one ManIndex reads, so the pages are embedded as they are. -->
    <DocsSourceRoot Condition="'$(DocsSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\jyro-doc\manual</DocsSourceRoot>
  </PropertyGroup>
  <Target Name="WarnMissingManDocs" BeforeTargets="BeforeBuild" Condition="!Exists('$(DocsSourceRoot)')">
    <Warning Text="Documentation not found at '$(DocsSourceRoot)'; 'jyro man' will have no pages. Clone https://github.com/realtree-systems/jyro-doc beside jyro-cli or set DocsSourceRoot." />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="$(DocsSourceRoot)\**\*.md">
      <LogicalName>man/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <!-- LogFunction and other host-side types are internal; the test project
         exercises them directly rather than through the process boundary. -->
    <InternalsVisibleTo Include="Jyro.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="ConsoleOutput.fs" />
    <Compile Include="JsonComparer.fs" />
    <Compile Include="JsonSerializer.fs" />
    <Compile Include="SimpleFileLoggerProvider.fs" />
    <Compile Include="LogFunction.fs" />
    <Compile Include="PluginLoader.fs" />
    <Compile Include="Configuration.fs" />
    <Compile Include="ScriptExecutor.fs" />
    <Compile Include="ManIndex.fs" />
    <Compile Include="ManPageRenderer.fs" />
    <Compile Include="ManBrowser.fs" />
    <Compile Include="ManCommand.fs" />
    <Compile Include="CommandArgs.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <!-- FSharp.Core is provided implicitly by the F# SDK -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.3" />
    <ProjectReference Include="..\..\..\jyro-lang\src\Jyro.Api\Jyro.Api.fsproj" />
    <ProjectReference Include="..\..\..\jyro-lang\src\Jyro.Compiler\Jyro.Compiler.fsproj" />
    <ProjectReference Include="..\..\..\jyro-lang\src\Jyro.Core\Jyro.Core.fsproj" />
    <ProjectReference Include="..\..\..\jyro-lang\src\Jyro.Parser\Jyro.Parser.fsproj" />
    <ProjectReference Include="..\..\..\jyro-lang\src\Jyro.Stdlib\Jyro.Stdlib.fsproj" />
  </ItemGroup>
</Project>